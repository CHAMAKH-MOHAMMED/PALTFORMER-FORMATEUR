<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="trainers_list_template" name="Trainers List">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure"> <!-- Removed oe_empty -->
                <section class="academy-trainers-list-section"> <!-- Apply new class -->
                    <div class="container">
                        <h1 class="text-center">Our Trainers</h1>

                        <!-- Call to action for public users -->
                        <div t-if="user_id._is_public()" class="trainers-list-prompt my-4" role="alert"> <!-- Apply new class -->
                            <strong>Are you a trainer?</strong> <a t-attf-href="/web/login?redirect=/trainers/profile/edit" class="alert-link">Log in or Register</a> to create your profile and showcase your expertise!
                            <br/>
                            <strong>Are you a training center?</strong> <a t-attf-href="/web/login?redirect=/trainers/search" class="alert-link">Log in or Register</a> to find the best trainers.
                        </div>

                        <div class="row">
                            <t t-if="trainers">
                                <t t-foreach="trainers" t-as="trainer">
                                    <div class="col-md-6 col-lg-4 mb-4 d-flex align-items-stretch"> <!-- Adjusted column classes, d-flex for equal height -->
                                        <div class="trainer-card"> <!-- Apply new class -->
                                            <div class="card-body">
                                                <h5 class="card-title"><t t-esc="trainer.name"/></h5>
                                                <p class="card-text">
                                                    <t t-if="trainer.domains">
                                                        <strong>Domains:</strong> <t t-esc="', '.join([d.name for d in trainer.domains])"/><br/>
                                                    </t>
                                                    <t t-if="trainer.location">
                                                        <strong>Location:</strong> <t t-esc="trainer.location"/><br/>
                                                    </t>
                                                    <t t-if="trainer.availability">
                                                        <strong>Availability:</strong> <t t-esc="dict(trainer._fields['availability'].selection).get(trainer.availability)"/>
                                                    </t>
                                                </p>
                                                <a t-attf-href="/trainers/{{ trainer.id }}" class="btn btn-primary">View Profile</a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-12">
                                    <div class="alert alert-secondary text-center" role="alert">
                                        <p class="mb-0">No trainers found at the moment. <t t-if="user_id._is_public()">Why not <a t-attf-href="/web/login?redirect=/trainers/profile/edit" class="alert-link">register as one</a>?</t></p>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
