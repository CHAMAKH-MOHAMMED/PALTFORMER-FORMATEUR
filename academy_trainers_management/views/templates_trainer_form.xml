<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="trainer_profile_form_template" name="Trainer Profile Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="py-5">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-8 offset-md-2">
                                <h1 t-if="page_name == 'create_trainer_profile'">Create Your Trainer Profile</h1>
                                <h1 t-if="page_name == 'edit_trainer_profile'">Edit Your Trainer Profile</h1>
                                <form method="POST" t-attf-action="{{ '/trainers/profile/create' if page_name == 'create_trainer_profile' else '/trainers/profile/edit' }}" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="form-group">
                                        <label for="name">Full Name</label>
                                        <input type="text" class="form-control" name="name" t-att-value="trainer.name if trainer else ''" required="required"/>
                                    </div>
                                    <div class="form-group">
                                        <label for="email">Email</label>
                                        <input type="email" class="form-control" name="email" t-att-value="trainer.email if trainer else ''" required="required"/>
                                    </div>
                                    <div class="form-group">
                                        <label for="phone">Phone</label>
                                        <input type="text" class="form-control" name="phone" t-att-value="trainer.phone if trainer else ''"/>
                                    </div>
                                    <div class="form-group">
                                        <label for="location">Location</label>
                                        <input type="text" class="form-control" name="location" t-att-value="trainer.location if trainer else ''"/>
                                    </div>
                                    <div class="form-group">
                                        <label for="availability">Availability</label>
                                        <select name="availability" class="form-control">
                                            <option value="available" t-att-selected="trainer and trainer.availability == 'available'">Available</option>
                                            <option value="unavailable" t-att-selected="trainer and trainer.availability == 'unavailable'">Unavailable</option>
                                            <option value="partial" t-att-selected="trainer and trainer.availability == 'partial'">Partially Available</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="domains">Expertise Domains</label>
                                        <!-- This needs a proper widget, e.g., many2many_tags_website -->
                                        <!-- For simplicity, a text input or a multi-select if domains are pre-loaded -->
                                        <select name="domain_ids" class="form-control" multiple="multiple" id="domain_ids">
                                            <t t-foreach="request.env['academy.trainer.domain'].search([])" t-as="domain">
                                                <option t-att-value="domain.id" t-att-selected="trainer and domain.id in trainer.domains.ids"><t t-esc="domain.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="bio">Biography</label>
                                        <textarea class="form-control" name="bio" rows="5"><t t-esc="trainer.bio if trainer else ''"/></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary mt-3">Save Profile</button>
                                </form>

                                <t t-if="page_name == 'edit_trainer_profile' and trainer">
                                    <hr class="my-4"/>
                                    <h2>Manage CVs</h2>
                                    <!-- CV List -->
                                    <ul t-if="trainer.cv_ids">
                                        <li t-foreach="trainer.cv_ids" t-as="cv">
                                            <t t-esc="cv.name"/> - <a t-attf-href="/web/content/academy.trainer.cv/{{cv.id}}/cv_file?download=true">Download</a>
                                            <!-- Add delete CV option here -->
                                        </li>
                                    </ul>
                                    <t t-else="">
                                        <p>No CVs uploaded yet.</p>
                                    </t>
                                    <!-- CV Upload Form -->
                                    <form method="POST" action="/trainers/profile/cv/upload" enctype="multipart/form-data" class="mt-3">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="form-group">
                                            <label for="cv_file">Upload New CV</label>
                                            <input type="file" class="form-control-file" name="cv_file" required="required"/>
                                        </div>
                                        <div class="form-group">
                                            <label for="cv_title">CV Title/Name</label>
                                            <input type="text" class="form-control" name="name" required="required" placeholder="e.g., My Latest CV"/>
                                        </div>
                                        <button type="submit" class="btn btn-secondary mt-2">Upload CV</button>
                                    </form>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
